# ---- Telegram: create a bot with @BotFather, add it as admin to your channel ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Anthropic (optional; only used when classifier.llm.enabled = true) ----
ANTHROPIC_API_KEY=

# ---- Which publishers to use, comma separated: telegram,dryrun ----
PUBLISHERS=dryrun
